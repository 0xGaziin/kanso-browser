{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kanso-browser",
  "version": "0.1.0",
  "identifier": "com.kanso.browser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kanso",
        "minWidth": 500,
        "minHeight": 400,
        "center": true,
        "maximized": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/kanso-logo.png"
    ]
  }
}